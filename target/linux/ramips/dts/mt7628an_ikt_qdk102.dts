#include "mt7628an.dtsi"

#include <dt-bindings/input/input.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	compatible = "ikt,qdk102", "mediatek,mt7628an-soc";
	model = "qdk102";

	aliases {
		led-boot = &led_sys;
		led-failsafe = &led_sys;
		led-running = &led_sys;
		led-upgrade = &led_sys;
	};

	chosen {
		bootargs = "console=ttyS0,115200";
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&gpio 38 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
		sim1 {
			label = "sim1_det";
			gpios = <&gpio 4 1>; //gpio4 
			linux,code = <0x100>;
		};
		sim2 {
			label = "sim2_det";
			gpios = <&gpio 11 1>; //gpio11 
			linux,code = <0x101>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_sys:sys_run {
			label = "qdk102:sys";
			gpios = <&gpio 44 0>; //gpio44
		};
		led_lte {
			label = "qdk102:lte";
			gpios = <&gpio 0 1>; //gpio0
		};
		led_net {
			label = "qdk102:net";
			gpios = <&gpio 5 1>; //gpio5
		};
	};


        gpio_export {
                compatible = "gpio-export";
                #size-cells = <0>;

                modem {
                        gpio-export,name = "modem-pwr";
                        gpio-export,output = <1>;
                        gpios = <&gpio 3 GPIO_ACTIVE_HIGH>;
                };
                
		sim-ctl {
                        gpio-export,name = "sim-switch";
                        gpio-export,output = <1>;
                        gpios = <&gpio 1 GPIO_ACTIVE_HIGH>;
                };
        };


	watchdog_0:watchdog {
		compatible = "linux,wdt-gpio";
		gpios = <&gpio 2 1>; //gpio2
		hw_algo = "toggle";
		hw_margin_ms = <1300>;
		always-running = <1>;
		status = "okay";
	};

	uart1@d00 {
		status = "okay";
	};
};

&state_default {
	gpio {
		groups = "gpio","perst","refclk","wdt","i2c","i2s","wled_an";
		function = "gpio";
	};
	p4led_an{
				ralink,group = "p4led_an";
				ralink,function = "p4led_an";
	};
	p3led_an{
				ralink,group = "p3led_an";
				ralink,function = "p3led_an";
	};
	p2led_an{
				ralink,group = "p2led_an";
				ralink,function = "p2led_an";
	};
	p1led_an{
				ralink,group = "p1led_an";
				ralink,function = "p1led_an";
	};
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <10000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x30000>;
				read-only;
			};

			partition@30000 {
				label = "u-boot-env";
				reg = <0x30000 0x10000>;
				read-only;
			};

			factory: partition@40000 {
				label = "factory";
				reg = <0x40000 0x10000>;
				// read-only;
			};

			partition@50000 {
				compatible = "denx,uimage";
				label = "firmware";
				reg = <0x50000 0xfb0000>;
			};
		};
	};
};

&wmac {
	status = "okay";
};

&ethernet {
	mtd-mac-address = <&factory 0x2e>;
};

&esw {
	mediatek,portmap = <0x2f>;
};
